{
  "name": "vinted-telegram-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot that monitors Vinted search URLs and pushes new listings to private chats, groups or forum topics",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node --check src/index.js",
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.5.0",
    "grammy": "^1.36.1",
    "undici": "^6.21.1"
  }
}
