# ---- Telegram ----
BOT_TOKEN=123456:ABC-your-token-from-@BotFather
# Telegram user ids (comma separated) allowed to run /grant, /stats
ADMIN_IDS=

# ---- Storage ----
DB_PATH=./data/bot.sqlite

# ---- Polling tiers (seconds between checks of one search) ----
INTERVAL_FREE=900
INTERVAL_BASIC=300
INTERVAL_PRO=60
# random jitter added to every interval, avoids synchronized bursts
JITTER_PCT=20

# ---- Plan limits: max searches / max destination chats ----
# Scout is a 24h trial now, not a free tier — see the Plans block below
LIMIT_FREE_SEARCHES=2
LIMIT_BASIC_SEARCHES=25
LIMIT_PRO_SEARCHES=100
LIMIT_CHATS=20

# ---- Vinted fetching ----
# max catalog requests per second across the whole process (per domain)
VINTED_RPS=1.5
VINTED_PER_PAGE=40
# catalog endpoint: empty = auto-detect, or pin one name from src/vinted/endpoints.js
# (svc-catalogue | svc-catalogue-attrs | svc-catalogue-www | legacy-catalog)
VINTED_API_STRATEGY=

# ignore listings older than N minutes on the very first poll of a search
FIRST_RUN_MAX_AGE_MIN=0
# comma separated proxies, e.g. http://user:pass@host:port,socks5://...
# REQUIRED since 17.09.2026: the catalog endpoint answers 403 to datacenter IPs
PROXIES=

# ---- Proxy capacity ----
# What each proxy is believed to survive, sustained, in requests per second.
# One number per entry of PROXIES, same order — a residential pool and one
# cheap datacenter IP are not safe at the same rate, so this is not a single
# constant. Anything not listed here uses PROXY_SAFE_RPS_DEFAULT.
#   PROXIES=http://a,http://b,http://c
#   PROXY_SAFE_RPS=1.2,0.7      -> a=1.2, b=0.7, c=the default
PROXY_SAFE_RPS=
PROXY_SAFE_RPS_DEFAULT=0.7

# The pool's budget is the sum of those. Load is counted as distinct active
# searches per domain divided by the interval their fastest holder pays for —
# identical searches share one fetch, so they cost one slot between them.
# At WARN the log says so; at ALERT the admins get a DM. A new search that
# would push the total past the budget is refused instead of being sold.
CAPACITY_WARN_PCT=80
CAPACITY_ALERT_PCT=90
CAPACITY_CHECK_SEC=60
# how long before the same standing alarm is repeated, in minutes
CAPACITY_REPEAT_MIN=60
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36

# ---- Branding ----
# Pictures: an https URL or a local file path. Both are fallbacks — an admin can
# replace either at runtime with /setstartimage and /sethelpimage (just send the
# bot a photo), and that choice is stored in the database and wins over these.
# START_IMAGE sits above the menu on /start.
# HELP_IMAGE is the photo of a sample alert shown with /help.
START_IMAGE=
HELP_IMAGE=

# ---- Delivery pacing ----
# What Telegram itself allows — the ceiling no plan may be sold past.
TELEGRAM_GLOBAL_RPS=25
TELEGRAM_GROUP_PER_MIN=20
TELEGRAM_PRIVATE_PER_MIN=60
TELEGRAM_BURST=10

# How much of that allowance each plan may spend at once: how many listings
# leave back to back before pacing starts. This is the paid speed difference.
# 1 means no burst at all — the strict steady rate, one listing at a time — and
# a tier set to 1 says nothing about burst in /plan rather than advertising
# "burst 1" as if it were a feature. Burst is something the paid tiers buy.
BURST_FREE=1
BURST_BASIC=1
BURST_PRO=20
BURST_TURBO=30
# BURST_ELITE_MAX lives in the reserved-tier block below

# Optional: hold a plan below the chat's sustained rate (messages per minute).
# 0 = leave the chat ceiling alone. Values above it are clamped — the sustained
# rate is Telegram's, and selling more of it only buys 429s.
RATE_FREE_PER_MIN=0
RATE_BASIC_PER_MIN=0
RATE_PRO_PER_MIN=0
RATE_TURBO_PER_MIN=0

# ---- Notifications ----
# do not send the same item twice into the same chat/topic even if it matched several searches
DEDUPE_PER_DESTINATION=true

# ---- The floor ----
# What an account holds before it has bought anything, and what every plan
# falls back to when its paid time runs out. Its searches are not polled and
# it cannot add a link — raise the limit to hand out a standing allowance
# instead, without touching any code.
LIMIT_LOCKED_SEARCHES=0

# ---- Plans ----
# Names shown to users live in src/i18n/locales/*: Scout, Hunter, Ranger,
# Sniper Elite. Internal keys stay free/basic/pro/turbo so stored rows keep
# their meaning. Prices below are what the comparison shows.
#
# Scout is the way in: a real purchase priced like a coffee that runs out in a
# day, not a permanent free tier. Everything above it is sold by the month.
PRICE_USD_FREE=1
PRICE_USD_BASIC=9
PRICE_USD_PRO=19
PRICE_USD_TURBO=79

# Telegram Stars actually charged. Leave a price empty and that tier has no
# buy button — the tier itself still exists.
SCOUT_PRICE_STARS=77
BASIC_PRICE_STARS=
PRO_PRICE_STARS=
TURBO_PRICE_STARS=
PLAN_DAYS=30
SCOUT_TRIAL_HOURS=24

# Extra links on top of a paid plan. NOT on sale: flat pricing across tiers did
# not reflect what a link costs on a fast tier versus a slow one, so nothing on
# the plan screen offers it and more capacity means the next tier up. The code
# is still here — set ADDON_PRICE_STARS to bring the button back.
ADDON_LINKS=10
ADDON_PRICE_USD=2
ADDON_PRICE_STARS=

# Sniper Elite polls on its own clock — twice as often as Ranger, so the price
# jump buys speed and not only links and burst.
INTERVAL_TURBO=30
LIMIT_TURBO_SEARCHES=300

# ---- Seats: how many accounts may hold a tier at once ----
# 0 = uncapped. A cap is enforced everywhere a tier is handed out: the buy
# button says there are no spots, a Stars purchase is declined before it is
# charged (and refunded if the last seat went while the payment was in
# flight), and /grant refuses. This is what makes "limited spots" true.
MAX_HUNTER_SEATS=0
MAX_RANGER_SEATS=0
MAX_SNIPER_ELITE_SEATS=10
MAX_ELITE_MAX_SEATS=0

# ---- elite_max: reserved, never sold ----
# No price, no button, absent from the comparison. Only /grant <id> elite_max.
# Kept ahead of INTERVAL_TURBO: the reserved tier is only reserved if nothing
# on sale matches it.
INTERVAL_ELITE_MAX=15
LIMIT_ELITE_MAX_SEARCHES=1000
BURST_ELITE_MAX=50

# Pictures shown when someone reaches a tier. Same as the others: an https URL
# or a path, and an admin can replace any of them from Telegram with
# /settierimage <hunter|ranger|sniper|elite_max>. No picture = text only.
TIER_IMAGE_HUNTER=
TIER_IMAGE_RANGER=
TIER_IMAGE_SNIPER=
TIER_IMAGE_ELITE_MAX=

# ---- Support ----
# Telegram id of whoever answers /support. Messages are relayed both ways;
# an answer is a plain reply to the forwarded message. 0 hides the button.
SUPPORT_TG_ID=0

# ---- Near-miss note ----
# When a listing is already this old on arrival, a slower plan is told what it
# cost them — at most once every FOMO_EVERY_HOURS. Never shown to the tiers
# that already deliver instantly.
FOMO_AFTER_SECONDS=30
FOMO_EVERY_HOURS=24

LOG_LEVEL=info
