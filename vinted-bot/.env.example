# ---- Telegram ----
BOT_TOKEN=123456:ABC-your-token-from-@BotFather
# Telegram user ids (comma separated) allowed to run /grant, /stats
ADMIN_IDS=

# ---- Storage ----
DB_PATH=./data/bot.sqlite

# ---- Polling tiers (seconds between checks of one search) ----
INTERVAL_FREE=900
INTERVAL_BASIC=300
INTERVAL_PRO=60
# random jitter added to every interval, avoids synchronized bursts
JITTER_PCT=20

# ---- Plan limits: max searches / max destination chats ----
LIMIT_FREE_SEARCHES=3
LIMIT_BASIC_SEARCHES=25
LIMIT_PRO_SEARCHES=100
LIMIT_CHATS=20

# ---- Vinted fetching ----
# max catalog requests per second across the whole process (per domain)
VINTED_RPS=1.5
VINTED_PER_PAGE=40
# ignore listings older than N minutes on the very first poll of a search
FIRST_RUN_MAX_AGE_MIN=0
# comma separated proxies, e.g. http://user:pass@host:port,socks5://...
PROXIES=
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36

# ---- Notifications ----
# do not send the same item twice into the same chat/topic even if it matched several searches
DEDUPE_PER_DESTINATION=true

# ---- Optional: Telegram Stars payments (leave empty to hide the paywall) ----
PRO_PRICE_STARS=
BASIC_PRICE_STARS=
PLAN_DAYS=30

LOG_LEVEL=info
